# URL pública usada para generar canonicals, Open Graph y sitemap.xml.
# También se acepta como Origin válido en las rutas /api/auth y /api/backend.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Raíz del backend (sin /api/v1). Solo servidor: route handlers, proxy y
# Server Actions. El navegador nunca llama al backend directamente.
API_URL=http://127.0.0.1:8000

# Secreto compartido con el backend; el BFF lo envía como X-BFF-Secret en cada
# llamada servidor→backend. Solo servidor; nunca usar prefijo NEXT_PUBLIC_.
BFF_SHARED_SECRET=

# Endpoint público de leads de demo.
DEMO_LEADS_API_PATH=/api/v1/demo-requests

# Opt-in Playwright acceptance against a running real frontend/backend stack.
PLAYWRIGHT_REAL=0
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
