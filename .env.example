# URL pública usada para generar canonicals, Open Graph y sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL del backend para Server Actions; no se expone al navegador.
API_URL=http://127.0.0.1:8000

# Base URL pública usada por el cliente HTTP del frontend.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Endpoint público de leads de demo.
DEMO_LEADS_API_PATH=/api/v1/demo-requests

# Opt-in Playwright acceptance against a running real frontend/backend stack.
PLAYWRIGHT_REAL=0
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
